{
  "name": "sundeepparuchuri-com",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --require ./scripts/no-network.cjs node_modules/wrangler/bin/wrangler.js dev --local",
    "test": "node --require ./scripts/no-network.cjs --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps": "node scripts/local-checks.mjs deps",
    "hooks": "git config core.hooksPath .githooks",
    "smoke": "node scripts/local-checks.mjs smoke",
    "verify": "node scripts/local-checks.mjs full",
    "coverage": "node scripts/local-checks.mjs coverage",
    "pr:check": "node scripts/git-gate.mjs check",
    "pr": "node scripts/git-gate.mjs pr"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "wrangler": "4.148.0"
  },
  "engines": {
    "node": "24.x"
  }
}
